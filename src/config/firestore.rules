rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sólo usuarios autenticados pueden leer/operar empleados
    function isSignedIn() {
      return request.auth != null;
    }

    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && validEmployee(request.resource.data);
      allow update: if isSignedIn() && validEmployee(request.resource.data);
      allow delete: if isSignedIn();

      function validEmployee(data) {
        return
          // campos obligatorios
          data.keys().hasAll(['id','name','department','salary']) &&
          // tipos y límites básicos
          data.id is string &&
          data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
          data.department is string && data.department.size() > 0 && data.department.size() <= 100 &&
          data.salary is number && data.salary >= 0;
      }
    }

    // Bloquear todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}